# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/growth_automation

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Hunter.io API
HUNTER_API_KEY=your_hunter_api_key_here

# Ollama lead scoring
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Olama hosted API
OLAMA_API_KEY=your_olama_api_key_here
OLAMA_API_URL=https://ollama.com/api/chat
